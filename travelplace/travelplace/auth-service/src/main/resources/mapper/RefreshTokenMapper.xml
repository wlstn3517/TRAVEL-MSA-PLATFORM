<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.travel.auth.mapper.RefreshTokenMapper">

    <!-- 리프레시 토큰 저장 -->
    <insert id="insert" parameterType="com.travel.auth.domain.RefreshToken">
        INSERT INTO refresh_token (username, token, expires_at)
        VALUES (#{username}, #{token}, #{expiresAt})
    </insert>

    <!-- 토큰 값으로 조회 - refresh 엔드포인트에서 쿠키 검증 시 사용 -->
    <select id="findByToken" resultType="com.travel.auth.domain.RefreshToken">
        SELECT id, username, token, expires_at, created_at
        FROM refresh_token
        WHERE token = #{token}
    </select>

    <!-- 해당 토큰만 삭제 - 로그아웃 시 사용 -->
    <delete id="deleteByToken">
        DELETE FROM refresh_token WHERE token = #{token}
    </delete>

    <!-- 사용자 전체 토큰 삭제 - 재로그인 시 기존 토큰 정리 -->
    <delete id="deleteByUsername">
        DELETE FROM refresh_token WHERE username = #{username}
    </delete>

</mapper>
