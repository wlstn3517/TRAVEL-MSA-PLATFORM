<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    ExportDataMapper SQL

    엑셀 생성에 필요한 데이터 조회
    batch-service가 travel DB에 직접 접근하여 조회
-->
<mapper namespace="com.travel.mapper.ExportDataMapper">

    <!--
        사용자 전체 목록 조회
        users 테이블에서 엑셀에 필요한 컬럼만 조회
        username 기준 오름차순 정렬
    -->
    <select id="selectAllUsers" resultType="com.travel.dto.UserExcelDto">
        SELECT
            username,
            name,
            role
        FROM users
        ORDER BY username ASC
    </select>

    <!--
        쿠폰 발급 내역 전체 조회
        travel_coupon (발급 내역) + coupon_master (쿠폰 정책) LEFT JOIN
        issued_at 기준 최신 순 정렬

        DATE_FORMAT 으로 발급 일시를 "yyyy-MM-dd HH:mm:ss" 형식 문자열로 변환
        프론트에서 별도 파싱 없이 엑셀에 바로 표시 가능
    -->
    <select id="selectAllIssuedCoupons" resultType="com.travel.dto.CouponExcelDto">
        SELECT
            tc.username                                         AS username,
            cm.coupon_name                                      AS couponName,
            cm.discount_type                                    AS discountType,
            cm.discount_value                                   AS discountValue,
            tc.travel_id                                        AS travelId,
            DATE_FORMAT(tc.issued_at, '%Y-%m-%d %H:%i:%s')     AS issuedAt,
            tc.used_yn                                          AS usedYn
        FROM travel_coupon tc
        LEFT JOIN coupon_master cm ON tc.coupon_id = cm.coupon_id
        ORDER BY tc.issued_at DESC
    </select>

</mapper>
