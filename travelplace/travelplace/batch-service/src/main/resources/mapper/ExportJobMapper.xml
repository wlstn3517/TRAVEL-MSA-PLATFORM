<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    ExportJobMapper SQL

    admin_export_jobs 테이블 CRUD
    엑셀 내보내기 잡 등록 / 조회 / 상태 업데이트 처리
-->
<mapper namespace="com.travel.mapper.ExportJobMapper">

    <!--
        ExportJob 결과 매핑 (file_data 제외 - 상태 조회용)
        snake_case DB 컬럼 → camelCase Java 필드 변환
    -->
    <resultMap id="exportJobStatusMap" type="com.travel.domain.ExportJob">
        <id     property="id"           column="id" />
        <result property="jobType"      column="job_type" />
        <result property="status"       column="status" />
        <result property="requestedBy"  column="requested_by" />
        <result property="requestedAt"  column="requested_at" />
        <result property="completedAt"  column="completed_at" />
        <result property="fileName"     column="file_name" />
        <result property="errorMessage" column="error_message" />
        <!-- fileData 필드는 여기서 매핑하지 않음 - 불필요한 BLOB 로드 방지 -->
    </resultMap>

    <!--
        ExportJob 결과 매핑 (file_data 포함 - 다운로드용)
    -->
    <resultMap id="exportJobDownloadMap" type="com.travel.domain.ExportJob">
        <id     property="id"           column="id" />
        <result property="jobType"      column="job_type" />
        <result property="status"       column="status" />
        <result property="requestedBy"  column="requested_by" />
        <result property="requestedAt"  column="requested_at" />
        <result property="completedAt"  column="completed_at" />
        <result property="fileName"     column="file_name" />
        <result property="fileData"     column="file_data" />
        <result property="errorMessage" column="error_message" />
    </resultMap>

    <!--
        새 내보내기 잡 등록
        useGeneratedKeys: INSERT 후 자동 생성된 PK를 job.id 에 세팅
        status 는 항상 PENDING 으로 시작
        requested_at 은 DB DEFAULT NOW() 로 자동 설정
    -->
    <insert id="insertExportJob" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO admin_export_jobs (
            job_type,
            status,
            requested_by
        ) VALUES (
            #{jobType},
            'PENDING',
            #{requestedBy}
        )
    </insert>

    <!--
        상태 조회용 단건 조회 (file_data 제외)
        프론트 폴링 시 매 요청마다 BLOB 전송하면 네트워크 낭비 → 제외
    -->
    <select id="selectStatusById" resultMap="exportJobStatusMap">
        SELECT
            id,
            job_type,
            status,
            requested_by,
            requested_at,
            completed_at,
            file_name,
            error_message
        FROM admin_export_jobs
        WHERE id = #{id}
    </select>

    <!--
        다운로드용 단건 조회 (file_data 포함)
        COMPLETED 상태 확인 후 파일 데이터 반환 시 사용
    -->
    <select id="selectForDownload" resultMap="exportJobDownloadMap">
        SELECT
            id,
            job_type,
            status,
            file_name,
            file_data
        FROM admin_export_jobs
        WHERE id = #{id}
    </select>

    <!--
        PENDING 상태 잡 전체 조회
        @Scheduled 워커가 처리할 대상 목록을 가져올 때 사용
        등록 순서대로 처리 (FIFO)
    -->
    <select id="selectPendingJobs" resultMap="exportJobStatusMap">
        SELECT
            id,
            job_type,
            status,
            requested_by
        FROM admin_export_jobs
        WHERE status = 'PENDING'
        ORDER BY id ASC
    </select>

    <!--
        상태를 PROCESSING 으로 변경
        워커가 처리 시작 시 호출
        PENDING 상태인 경우에만 업데이트 (이중 처리 방지 안전장치)
    -->
    <update id="updateToProcessing">
        UPDATE admin_export_jobs
        SET status = 'PROCESSING'
        WHERE id = #{id}
          AND status = 'PENDING'
    </update>

    <!--
        잡 완료 처리
        status = COMPLETED, 파일명, 파일 바이너리, 완료 시각 저장
    -->
    <update id="updateToCompleted">
        UPDATE admin_export_jobs
        SET
            status       = 'COMPLETED',
            file_name    = #{fileName},
            file_data    = #{fileData},
            completed_at = NOW()
        WHERE id = #{id}
    </update>

    <!--
        잡 실패 처리
        status = FAILED, 오류 메시지, 완료 시각 저장
    -->
    <update id="updateToFailed">
        UPDATE admin_export_jobs
        SET
            status        = 'FAILED',
            error_message = #{errorMessage},
            completed_at  = NOW()
        WHERE id = #{id}
    </update>

</mapper>
