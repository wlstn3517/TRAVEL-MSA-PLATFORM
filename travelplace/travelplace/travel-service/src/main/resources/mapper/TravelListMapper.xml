<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    여행지 리스트 조회 매퍼
    검색 페이지(/search) 데이터 제공용
    지역 필터 + 키워드 검색 + 페이징 처리
-->
<mapper namespace="com.travel.travel.mapper.TravelListMapper">

    <!--
        여행지 목록 조회
        GET /api/travel/list?areaCode=&keyword=&page=&size=

        travel_recommend_meta JOIN 제거
        해당 테이블 삭제로 인해 JOIN 시 오류 발생
        recommend_yn 컬럼도 함께 제거
        → DestinationCard의 recommendYn prop은 optional이므로 없어도 badge 미표시로 정상 동작

        ORDER BY 변경
        기존 : recommend_yn DESC, content_id DESC (추천 우선 정렬)
        변경 : content_id DESC (최신 등록순)
        이유 : recommend_yn 컬럼 제거로 정렬 기준 변경 필요
    -->
	<select id="selectTravelList" resultType="map">
		SELECT
			content_id,
			title,
			addr1,
			first_image,
			area_code
		FROM travel_place
		WHERE 1=1

		<!-- 지역 코드 필터 (관광공사 area_code) -->
		<if test="areaCode != null and areaCode != ''">
			AND area_code = #{areaCode}
		</if>

		<!-- 여행지 이름 키워드 검색 (부분 일치) -->
		<if test="keyword != null and keyword != ''">
			AND title LIKE CONCAT('%', #{keyword}, '%')
		</if>

		<!-- 최신 등록순 정렬 -->
		ORDER BY content_id DESC

		<!-- 페이징: LIMIT 시작위치, 건수 (MySQL/MariaDB 문법) -->
		LIMIT #{offset}, #{size}
	</select>


    <!--
        여행지 전체 건수 조회
        페이징 totalPages 계산용
        목록 조회(selectTravelList)와 동일한 WHERE 조건 유지 필수
        조건이 다르면 건수와 실제 데이터 수 불일치 발생
    -->
	<select id="selectTravelCount" resultType="int">
		SELECT COUNT(*)
		FROM travel_place
		WHERE 1=1

		<if test="areaCode != null and areaCode != ''">
			AND area_code = #{areaCode}
		</if>

		<if test="keyword != null and keyword != ''">
			AND title LIKE CONCAT('%', #{keyword}, '%')
		</if>
	</select>

</mapper>
