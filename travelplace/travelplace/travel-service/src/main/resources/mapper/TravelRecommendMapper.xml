<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.travel.travel.mapper.TravelRecommendMapper">

    <!--
        추천 여행지 목록 조회 (페이징)

        [이미지·key 이슈 해결 - SQL alias]
        MyBatis map-underscore-to-camel-case 설정은 resultType="map" 에서 map의 key에 적용되지 않음
        오직 Java Bean(클래스) 필드명 매핑에만 적용됨
        따라서 프론트에서 item.contentId, item.firstImage 로 접근하려면
        SQL에서 AS contentId, AS firstImage 처럼 alias를 직접 지정해야 함
        (검색 페이지 TravelListMapper는 item.content_id snake_case로 접근하므로 문제 없었음)

        cat1 코드
        A01 : 자연   A02 : 문화·역사   A03 : 액티비티
        A04 : 쇼핑   A05 : 미식        B02 : 숙박

        [ORDER BY 변경: RAND() → content_id DESC]
        RAND()는 실행마다 순서가 달라져 페이징 불가
        같은 여행지가 1페이지·2페이지에 중복 등장하거나 누락될 수 있음
        content_id DESC(최신 등록순)으로 변경 → 페이지마다 일관된 결과 보장

        [페이징: LIMIT #{size} OFFSET #{offset}]
        offset = (page - 1) * size → ServiceImpl에서 계산 후 전달
    -->
    <select id="selectRecommendList" resultType="map">
        SELECT
            content_id  AS contentId,
            title,
            addr1,
            first_image AS firstImage,
            cat1
        FROM travel_place
        WHERE use_yn = 'Y'
          AND first_image IS NOT NULL
          AND first_image != ''

        <!--
            cat1 조건
            값이 있으면 해당 대분류만 필터링
            값이 없으면 전체 조회 (버튼 미선택 상태)
        -->
        <if test="cat1 != null and cat1 != ''">
            AND cat1 = #{cat1}
        </if>

        ORDER BY content_id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>


    <!--
        추천 여행지 전체 건수 조회

        페이징 UI에서 totalPages = ceil(totalCount / size) 계산에 사용
        목록 조회(selectRecommendList)와 동일한 WHERE 조건 유지 필수
        조건이 다르면 건수와 실제 데이터 수 불일치 → 마지막 페이지 빈 결과 발생
    -->
    <select id="selectRecommendCount" resultType="int">
        SELECT COUNT(*)
        FROM travel_place
        WHERE use_yn = 'Y'
          AND first_image IS NOT NULL
          AND first_image != ''

        <if test="cat1 != null and cat1 != ''">
            AND cat1 = #{cat1}
        </if>
    </select>

</mapper>
