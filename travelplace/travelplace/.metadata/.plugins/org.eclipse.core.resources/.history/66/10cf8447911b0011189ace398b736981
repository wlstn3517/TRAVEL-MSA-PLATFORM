########################################################
# Admin Service 기본 설정
########################################################

# 서비스 이름 (Eureka에 이 이름으로 등록됨)
# gateway에서 lb://admin-service로 라우팅됨
spring.application.name=admin-service

# 포트 (기존 서비스와 충돌 방지)
# auth: 8081, travel: 8082, batch: 8083 이므로 8084 사용
server.port=8084

########################################################
# JWT 설정
# auth-service와 동일한 시크릿 키 사용
# 동일한 키여야 토큰 검증 가능
########################################################

jwt.secret=travel-jwt-secret-key-2026-secure-auth-service-token

########################################################
# Eureka Client 설정
# Eureka 서버에 admin-service로 등록
# RestTemplate의 lb:// 동적 라우팅에 필요
########################################################

# Eureka 서버 주소
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/

# Eureka 클라이언트 활성화
eureka.client.enabled=true

# Eureka에서 다른 서비스 목록 조회 (lb:// 라우팅에 필요)
eureka.client.fetch-registry=true

# admin-service 자신도 Eureka에 등록
eureka.client.register-with-eureka=true

# IP 주소 기반 등록 (로컬 환경 호환성)
eureka.instance.prefer-ip-address=true

########################################################
# Actuator 설정
########################################################

management.endpoints.web.exposure.include=health,info

########################################################
# 로그 설정
########################################################

logging.level.root=INFO
