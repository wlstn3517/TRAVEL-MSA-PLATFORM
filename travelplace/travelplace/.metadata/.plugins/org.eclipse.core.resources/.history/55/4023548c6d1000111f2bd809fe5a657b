########################################################
# Gateway 기본 설정
########################################################

# gateway 서비스 포트
# auth-service(8081), travel-service(8082)와 충돌 방지
server.port=8080

# Spring Cloud Gateway 서비스 이름
# MSA 환경에서 서비스 식별용
spring.application.name=gateway-service


########################################################
# Auth Service 라우팅 설정
########################################################

# gateway 라우팅 ID (로그 식별용 이름)
spring.cloud.gateway.routes[0].id=auth-service

# 실제 auth-service 주소 (로컬 기준 8081)
spring.cloud.gateway.routes[0].uri=http://localhost:8081

# /api/auth/** 요청은 auth-service로 전달
spring.cloud.gateway.routes[0].predicates[0]=Path=/api/auth/**


########################################################
# Batch Service 라우팅 설정
# 중요: /api/admin/** 보다 먼저 선언되어야 함
########################################################

spring.cloud.gateway.routes[1].id=batch-service
spring.cloud.gateway.routes[1].uri=http://localhost:8083
spring.cloud.gateway.routes[1].predicates[0]=Path=/api/admin/batch/**


########################################################
# Admin API 라우팅 추가
# 포괄 경로이므로 batch 라우팅보다 뒤에 위치
########################################################

spring.cloud.gateway.routes[2].id=admin-service
spring.cloud.gateway.routes[2].uri=http://localhost:8081
spring.cloud.gateway.routes[2].predicates[0]=Path=/api/admin/**


########################################################
# Travel Service 라우팅 설정
########################################################

# travel-service 라우팅 ID
spring.cloud.gateway.routes[3].id=travel-service

# 실제 travel-service 주소 (로컬 기준 8082)
spring.cloud.gateway.routes[3].uri=http://localhost:8082

# /api/travel/** 요청은 travel-service로 전달
spring.cloud.gateway.routes[3].predicates[0]=Path=/api/travel/**


########################################################
# CORS 설정 (React 프론트 localhost:3000 대응)
########################################################

# 허용 Origin
spring.cloud.gateway.globalcors.cors-configurations.[/**].allowed-origins=http://localhost:3000

# 허용 HTTP Method
spring.cloud.gateway.globalcors.cors-configurations.[/**].allowed-methods=GET,POST,PUT,DELETE,OPTIONS

# 허용 Header
spring.cloud.gateway.globalcors.cors-configurations.[/**].allowed-headers=*

# 인증 정보 포함 허용 (JWT Authorization header 대응)
spring.cloud.gateway.globalcors.cors-configurations.[/**].allow-credentials=true

# Authorization 헤더 브라우저 노출 허용
# JWT 사용 시 안전하게 추가 추천
spring.cloud.gateway.globalcors.cors-configurations.[/**].exposed-headers=Authorization


########################################################
# JWT Authorization 헤더 전달 필터 (핵심)
########################################################

# Host Header 유지
# 일부 인증/보안 환경에서 필요
spring.cloud.gateway.default-filters[0]=PreserveHostHeader

# Cookie 헤더 제거
# 세션 기반 인증 혼합 시 충돌 방지
spring.cloud.gateway.default-filters[1]=RemoveRequestHeader=Cookie