########################################################
# Eureka Server 기본 설정
########################################################

# 서비스 이름 설정
spring.application.name=eureka-server

# Eureka Server 포트 (기본값 8761 그대로 사용)
server.port=8761

########################################################
# Eureka Server 자체 등록 비활성화
# 서버 자신은 클라이언트로 등록할 필요 없음
########################################################

# 자기 자신을 Eureka에 등록하지 않음
eureka.client.register-with-eureka=false

# 다른 서비스 목록을 가져오지 않음 (서버 자신이므로)
eureka.client.fetch-registry=false

# 서버 기동 시 동기화 대기 시간 제거
# 개발 환경에서 빠른 시작을 위해 0으로 설정
eureka.server.wait-time-in-ms-when-sync-empty=0

########################################################
# Eureka Server 대시보드 설정
########################################################

# Eureka 대시보드 활성화 (http://localhost:8761 에서 확인 가능)
eureka.dashboard.enabled=true

# 로그 레벨 설정
logging.level.com.netflix.eureka=WARN
logging.level.com.netflix.discovery=WARN
